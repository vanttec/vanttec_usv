<?xml version="1.0"?>
<sdf version="1.6">
  <model name="vtec_s3">
    <link name="base_link">
      <inertial>
        <pose>0 0 -0.2 0 0 0</pose>
        <mass>50.0</mass>
        <inertia>
          <ixx>0.5666666666666668</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1.0416666666666667</iyy>
          <iyz>0</iyz>
          <izz>1.5416666666666667</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <mesh>
            <uri>file://vtec_s3/meshes/vtec_s3.dae</uri>
            <scale>0.1 0.1 0.1</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="Coll">
        <pose>-0.4 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://vtec_s3/meshes/vtec_s4_minimal2.stl</uri>
            <scale>0.7 0.95 1.5</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Left thruster housing -->
    <link name="left_housing_link">
      <inertial>
        <pose>-0.3 0.23 -0.31 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.0020290833333333333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002408333333333333</iyy>
          <iyz>0</iyz>
          <izz>0.0006874166666666666</izz>
        </inertia>
      </inertial>

      <visual name="left_housing_visual">
        <pose>-0.3 0.23 -0.31 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://vtec_s3/meshes/housing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://vtec_s3/materials/textures/Thruster_Albedo.png</albedo_map>
              <roughness_map>file://vtec_s3/materials/textures/Thruster_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="Cylinder263d">
        <pose>-0.2833463 0.22986701 -0.31 1.5708 0.0 -1.5708</pose>
        <geometry>
          <cylinder>
            <length>0.14376</length>
            <radius>0.0243692</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Left propeller -->
    <link name="left_prop_link">
      <inertial>
        <pose>-0.300872875 0.229867016 -0.31 1.5708 0.0 -1.5708</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00010562499999999999</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00010562499999999999</iyy>
          <iyz>0</iyz>
          <izz>0.00015125000000000002</izz>
        </inertia>
      </inertial>
      <visual name="left_prop_visual">
        <pose>-0.3 0.23 -0.31 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://vtec_s3/meshes/prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://vtec_s3/materials/textures/Thruster_Albedo.png</albedo_map>
              <roughness_map>file://vtec_s3/materials/textures/Thruster_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="Cylinder262d">
        <pose>-0.300872875 0.229867016 -0.31 1.5708 0.0 -1.5708</pose>
        <geometry>
          <cylinder>
            <length>0.0608172</length>
            <radius>0.0553844</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Right thruster housing -->
    <link name="right_housing_link">
      <inertial>
        <pose>-0.3 -0.23 -0.31 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.0020290833333333333</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002408333333333333</iyy>
          <iyz>0</iyz>
          <izz>0.0006874166666666666</izz>
        </inertia>
      </inertial>
      <visual name="right_housing_visual">
        <pose>-0.3 -0.23 -0.31 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://vtec_s3/meshes/housing.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://vtec_s3/materials/textures/Thruster_Albedo.png</albedo_map>
              <roughness_map>file://vtec_s3/materials/textures/Thruster_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Thruster collisions -->
      <collision name="Cylinder263i">
        <pose>-0.2833463 -0.22986701 -0.31 1.5708 0.0 -1.5708</pose>
        <geometry>
          <cylinder>
            <length>0.14376</length>
            <radius>0.0243692</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Right propeller -->
    <link name="right_prop_link">
      <inertial>
        <pose>-0.300872875 -0.229867016 -0.31 1.5708 0.0 -1.5708</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.00010562499999999999</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00010562499999999999</iyy>
          <iyz>0</iyz>
          <izz>0.00015125000000000002</izz>
        </inertia>
      </inertial>
      <visual name="right_prop_visual">
        <pose>-0.3 -0.23 -0.31 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://vtec_s3/meshes/prop.dae</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>file://vtec_s3/materials/textures/Thruster_Albedo.png</albedo_map>
              <roughness_map>file://vtec_s3/materials/textures/Thruster_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="Cylinder262i">
        <pose>-0.300872875 -0.229867016 -0.31 1.5708 0.0 -1.5708</pose>
        <geometry>
          <cylinder>
            <length>0.0608172</length>
            <radius>0.0553844</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- Chassis-left engine joint -->
    <joint name="left_chasis_engine_joint" type="revolute">
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>10</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
      <parent>base_link</parent>
      <child>left_housing_link</child>
    </joint>

    <!-- Left joint housing-propeller -->
    <joint name="left_engine_propeller_joint" type="revolute">
      <pose>-0.300872875 0.229867016 -0.31 1.5708 0.0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
      <parent>left_housing_link</parent>
      <child>left_prop_link</child>
    </joint>

    <!-- Chassis-right engine joint -->
    <joint name="right_chasis_engine_joint" type="revolute">
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>0</lower>
          <upper>0</upper>
          <effort>10</effort>
          <velocity>10</velocity>
        </limit>
      </axis>
      <parent>base_link</parent>
      <child>right_housing_link</child>
    </joint>

    <!-- Right joint housing-propeller -->
    <joint name="right_engine_propeller_joint" type="revolute">
      <pose>-0.300872875 -0.229867016 -0.31 1.5708 0.0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <effort>100</effort>
          <velocity>100</velocity>
        </limit>
        <dynamics>
          <friction>0.05</friction>
          <damping>0.05</damping>
        </dynamics>
      </axis>
      <parent>right_housing_link</parent>
      <child>right_prop_link</child>
    </joint>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <joint_name>left_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.0001</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.5</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <joint_name>right_engine_propeller_joint</joint_name>
      <thrust_coefficient>0.0001</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.5</propeller_diameter>
      <velocity_control>true</velocity_control>
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <odom_covariance_topic>/gz_sim/odometry</odom_covariance_topic>
    </plugin>

    <!-- Hydrodynamics plugin -->
    <plugin
      filename="gz-waves1-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">

      <enable>vtec_s3::base_link</enable>

      <hydrodynamics>
        <damping_on>1</damping_on>
        <viscous_drag_on>1</viscous_drag_on>
        <pressure_drag_on>1</pressure_drag_on>

        <!-- Linear and Angular Damping -->
        <cDampL1>1.0E-6</cDampL1>
        <cDampL2>1.0E-6</cDampL2>
        <cDampR1>1.0E-6</cDampR1>
        <cDampR2>1.0E-6</cDampR2>

        <!-- 'Pressure' Drag -->
        <cPDrag1>1.0E+2</cPDrag1>
        <cPDrag2>1.0E+2</cPDrag2>
        <fPDrag>0.4</fPDrag>
        <cSDrag1>1.0E+2</cSDrag1>
        <cSDrag2>1.0E+2</cSDrag2>
        <fSDrag>0.4</fSDrag>
        <vRDrag>1.0</vRDrag>
      </hydrodynamics>
    </plugin>
  </model>
</sdf>

<!--

ros2 launch vrx_gz vrx_environment.launch.py world:=nbpark

ros2 run ros_gz_bridge parameter_bridge
/model/vtec_s3/joint/left_engine_propeller_joint/cmd_thrust@std_msgs/msg/Float64]gz.msgs.Double
ros2 run ros_gz_bridge parameter_bridge
/model/vtec_s3/joint/right_engine_propeller_joint/cmd_thrust@std_msgs/msg/Float64]gz.msgs.Double

ros2 topic pub /model/vtec_s3/joint/left_engine_propeller_joint/cmd_thrust std_msgs/msg/Float64
"data: 150"
ros2 topic pub /model/vtec_s3/joint/right_engine_propeller_joint/cmd_thrust std_msgs/msg/Float64
"data: 150"

-->